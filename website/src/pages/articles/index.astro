---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleListPage from '@/components/ArticleListPage.astro';
import { getPublishedArticles } from '@/lib/articles';
import { breadcrumbJsonLd } from '@/lib/jsonld';

const articles = await getPublishedArticles();
const crumbs = [{ label: '程皓醫師專欄' }];
---

<BaseLayout
  title="程皓醫師專欄"
  description="程皓醫師的運動傷害、體重管理、運動訓練與高壓氧治療專欄，提供診療觀念與衛教資訊，並附參考來源。"
  jsonLd={breadcrumbJsonLd(Astro.site, crumbs)}
>
  <ArticleListPage
    eyebrow="程皓醫師專欄"
    title="運動醫學、體重管理與高壓氧治療專欄"
    lede="依主題閱讀診療觀念、研究與日常照護資訊。社群文章附原始來源，各篇研究與指引則提供參考連結，方便延伸閱讀。"
    crumbs={crumbs}
    articles={articles}
    activeCategory="all"
  />
</BaseLayout>
