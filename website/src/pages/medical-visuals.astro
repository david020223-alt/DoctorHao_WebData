---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { medicalVisuals } from '@/lib/medical-visuals';
import { categories } from '@/data/categories';
import { MEDICAL_VISUALS } from '@/data/site.js';
const visuals = Object.values(medicalVisuals.articles);
---
<BaseLayout title="2D 醫學圖解" description="程皓醫師網站文章的平面 2D 示意圖與文字附註，依主題閱讀與下載。" noindex={!MEDICAL_VISUALS.galleryIndexable}>
  <div class="visual-library container">
    <header class="visual-library__header">
      <p class="visual-library__eyebrow">程皓醫師・好動人生 / MEDICAL VISUAL LIBRARY</p>
      <h1>把文章，變成看得懂的圖解。</h1>
      <p class="visual-library__lede">{visuals.length} 篇文章的 2D 圖解與文字附註。以平面線條、構造標示與重點圖卡，輔助理解文章內容。</p>
      <p class="visual-library__notice"><strong>示意草稿・尚待醫師審閱。</strong> 本素材為平面簡化示意，比例不供量測，也不代表程皓醫師已審定。不能用來診斷、選擇藥物劑量或自行施作治療。</p>
    </header>
    <section class="visual-library__catalog" aria-labelledby="catalog-title">
      <div class="visual-library__catalog-header">
        <div><p class="visual-library__eyebrow">逐篇對應 / ARTICLE ASSETS</p><h2 id="catalog-title">文章素材索引</h2></div>
        <label class="visual-library__search">搜尋主題或文章<input type="search" placeholder="例如：膝蓋、GLP-1、肌力" data-visual-search /></label>
      </div>
      <p role="status" aria-live="polite" data-visual-count>共 {visuals.length} 篇</p>
      <div class="visual-library__grid">
        {visuals.map(v => <article class="visual-tile" data-visual-tile data-search={`${v.title} ${v.articleTitle} ${v.slug} ${v.points.map(p => p.heading).join(' ')}`.toLocaleLowerCase()}>
          <a href={`/articles/${v.slug}/`} tabindex="-1" aria-hidden="true"><img src={`/medical-2d/${v.slug}.svg`} alt="" width="600" height="440" loading="lazy" decoding="async" /></a>
          <div class="visual-tile__body">
            <span class="visual-tile__category">{categories[v.category as keyof typeof categories]?.name ?? v.category}・示意草稿</span>
            <h3><a href={`/articles/${v.slug}/`}>{v.title}</a></h3>
            <p>{v.articleTitle}</p>
            <div class="visual-tile__links"><a href={`/medical-2d/${v.slug}-notes.svg`} download aria-label={`下載${v.title}的 2D 附註圖卡`}>下載 2D 圖卡與附註</a></div>
          </div>
        </article>)}
      </div>
      <p class="visual-library__muted">每篇圖解附有對應的文字說明、注意事項與參考來源。</p>
    </section>
  </div>
</BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>('[data-visual-search]');
  const tiles = [...document.querySelectorAll<HTMLElement>('[data-visual-tile]')];
  const count = document.querySelector<HTMLElement>('[data-visual-count]');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLocaleLowerCase();
    let shown = 0;
    for (const tile of tiles) { tile.hidden = !(tile.dataset.search ?? '').includes(query); if (!tile.hidden) shown++; }
    if (count) count.textContent = shown ? `顯示 ${shown} / ${tiles.length} 篇` : '沒有符合的主題；請嘗試較短的關鍵字。';
  });
</script>
<style>
  .visual-library { padding-block: clamp(2rem, 5vw, 5rem); }
  .visual-library__header { max-width: 920px; margin-bottom: 3rem; }
  .visual-library__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .08em; color: #277d80; }
  .visual-library h1 { max-width: 16em; font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.3; }
  .visual-library__lede { font-size: 18px; line-height: 1.9; max-width: 44em; }
  .visual-library__notice { background: #fff3e2; padding: 18px 22px; border-radius: 14px; line-height: 1.9; font-size: 14px; color: #754b1e; }
  .visual-library__muted { font-size: 13px; line-height: 1.9; color: var(--c-muted); }
  .visual-library__catalog { padding-top: 2rem; border-top: 1px solid var(--c-line); }
  .visual-library__catalog-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; }
  .visual-library__search { display: grid; gap: 6px; font-size: 13px; }
  .visual-library__search input { width: min(320px, 100%); padding: 12px 14px; border: 1px solid var(--c-line); border-radius: 9px; font: inherit; background: white; }
  .visual-library__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-block: 24px; }
  .visual-tile { border: 1px solid var(--c-line); border-radius: 16px; overflow: hidden; background: white; }
  .visual-tile > a { display: block; }
  .visual-tile img { width: 100%; height: auto; display: block; }
  .visual-tile__body { padding: 20px; }
  .visual-tile__category { color: #347577; font-size: 12px; }
  .visual-tile h3 { font-size: 18px; line-height: 1.5; margin-block: 10px; }
  .visual-tile__body p { font-size: 13px; line-height: 1.8; color: var(--c-muted); }
  .visual-tile__links { display: flex; flex-wrap: wrap; gap: 18px; font-size: 13px; margin-top: 18px; }
  [hidden] { display: none !important; }
  @media (max-width: 900px) { .visual-library__grid { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (max-width: 540px) { .visual-library__grid { grid-template-columns: 1fr; } .visual-library__search, .visual-library__search input { width: 100%; } }
</style>
